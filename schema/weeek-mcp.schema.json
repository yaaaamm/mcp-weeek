{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mcp-weeek project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "boardUrl", "auth"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "boardUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://app\\.weeek\\.net/ws/[1-9][0-9]*/project/[1-9][0-9]*/board/[1-9][0-9]*/?$"
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "file", "variable"],
          "properties": {
            "source": { "const": "env-file" },
            "file": { "type": "string", "minLength": 1 },
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "variable"],
          "properties": {
            "source": { "const": "env" },
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      ]
    },
    "intakeFields": {
      "description": "Board fields the task author fills in (URL, section, location, …). init-board creates missing fields and missing select options.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 255 },
              "type": { "const": "text" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "options"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 255 },
              "type": { "const": "select" },
              "options": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 255 }
              }
            }
          }
        ]
      }
    }
  }
}
